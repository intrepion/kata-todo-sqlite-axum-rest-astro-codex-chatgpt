---
const title = 'Daymark — a calmer to-do list';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f5ef" />
    <meta name="description" content="A small, thoughtful to-do list that stays on your computer." />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="app-frame">
      <header class="topbar">
        <a class="brand" href="#top" aria-label="Daymark home">
          <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
          <span>daymark</span>
        </a>
        <div class="topbar-actions">
          <button class="quiet-button" id="history-button" type="button"><span aria-hidden="true">↺</span> Recovery history</button>
          <button class="quiet-button" id="export-button" type="button"><span aria-hidden="true">↓</span> Export</button>
          <button class="topbar-import" id="import-button" type="button"><span aria-hidden="true">↑</span> Import</button>
          <input class="visually-hidden" id="import-file" type="file" accept="application/json,.json" />
        </div>
      </header>

      <main id="top">
        <section class="intro" aria-labelledby="page-title">
          <div class="intro-copy">
            <p class="eyebrow"><span class="eyebrow-dot"></span> YOUR SPACE, YOUR PACE</p>
            <h1 id="page-title">A little more <em>clear.</em></h1>
            <p class="intro-text">Keep the next right thing close. Everything here stays on this computer.</p>
          </div>
          <div class="date-card" aria-label="Today">
            <span class="date-label">TODAY</span>
            <span class="date-value" id="today-label">—</span>
            <span class="date-flower" aria-hidden="true">✳</span>
          </div>
        </section>

        <section class="overview" aria-label="Task overview">
          <div class="overview-card overview-active"><span class="overview-icon" aria-hidden="true">○</span><span class="overview-label">IN MOTION</span><strong id="active-count">0</strong><span class="overview-caption">things to do</span></div>
          <div class="overview-card"><span class="overview-icon completed-icon" aria-hidden="true">✓</span><span class="overview-label">TAKEN CARE OF</span><strong id="completed-count">0</strong><span class="overview-caption">things completed</span></div>
          <div class="overview-note"><span class="note-spark" aria-hidden="true">✳</span><p>Small steps still<br /><em>move you forward.</em></p></div>
        </section>

        <section class="workspace" aria-label="Your to-do list">
          <nav class="view-nav" aria-label="Task views">
            <p class="nav-caption">YOUR LIST</p>
            <button class="view-button is-selected" type="button" data-view="active" aria-current="page"><span class="view-symbol">○</span><span>Active</span><span class="view-count" id="nav-active-count">0</span></button>
            <button class="view-button" type="button" data-view="completed"><span class="view-symbol">✓</span><span>Completed</span><span class="view-count" id="nav-completed-count">0</span></button>
            <button class="view-button" type="button" data-view="trashed"><span class="view-symbol">⌑</span><span>Trash</span><span class="view-count" id="nav-trashed-count">0</span></button>
            <div class="nav-tip"><span aria-hidden="true">↕</span><p>Drag to reorder<br />or use the arrows.</p></div>
          </nav>

          <div class="list-panel">
            <div class="list-heading">
              <div>
                <p class="section-kicker" id="list-kicker">A FRESH START</p>
                <h2 id="list-title">Your active list</h2>
                <p class="list-subtitle" id="list-subtitle">One thing at a time is plenty.</p>
              </div>
              <label class="search-box" for="search-input"><span aria-hidden="true">⌕</span><input id="search-input" type="search" placeholder="Search everything" autocomplete="off" /><kbd>⌘ K</kbd></label>
            </div>

            <div class="notice" id="notice" role="status" aria-live="polite" hidden></div>

            <form class="add-card" id="task-form">
              <div class="add-symbol" aria-hidden="true">＋</div>
              <div class="add-fields">
                <label class="visually-hidden" for="new-title">What needs doing?</label>
                <input id="new-title" name="title" placeholder="What needs doing?" required />
                <label class="visually-hidden" for="new-notes">Add a note (optional)</label>
                <textarea id="new-notes" name="notes" rows="1" placeholder="Add a note, if it helps…"></textarea>
              </div>
              <button class="add-button" type="submit">Add task <span aria-hidden="true">↗</span></button>
            </form>

            <div class="list-tools">
              <span id="result-label">YOUR NEXT STEPS</span>
              <button class="text-button danger-text" id="empty-trash-button" type="button" hidden>Empty trash</button>
            </div>
            <ul class="task-list" id="task-list" aria-label="Tasks"></ul>
            <div class="empty-state" id="empty-state" hidden>
              <span class="empty-orbit" aria-hidden="true">✳</span>
              <h3 id="empty-title">A little room to begin.</h3>
              <p id="empty-copy">Add a task above and let the day unfold.</p>
            </div>
            <p class="privacy-line"><span aria-hidden="true">⌂</span> Stored privately on this computer</p>
          </div>
        </section>
      </main>
      <footer class="footer"><span>DAYMARK</span><span>Make space for what matters.</span><span>LOCAL BY DESIGN <i aria-hidden="true">✳</i></span></footer>
    </div>

    <dialog class="modal" id="import-dialog" aria-labelledby="import-title">
      <form method="dialog" class="modal-close-row"><button class="modal-close" aria-label="Close preview">×</button></form>
      <p class="section-kicker">A FULL LIST REPLACEMENT</p>
      <h2 id="import-title">Review before importing</h2>
      <p class="modal-copy">This will replace the current list. A recovery point will keep the current version safe.</p>
      <div class="modal-warning" id="import-warning" role="status" aria-live="polite" hidden></div>
      <div class="count-comparison" id="import-counts"></div>
      <div class="preview-list-wrap"><p class="preview-label">INCOMING TASKS</p><ul class="preview-list" id="import-tasks"></ul></div>
      <div class="modal-actions"><button class="secondary-button" id="cancel-import" type="button">Cancel</button><button class="primary-button" id="apply-import" type="button">Replace list <span aria-hidden="true">↗</span></button></div>
    </dialog>

    <dialog class="modal history-modal" id="history-dialog" aria-labelledby="history-title">
      <form method="dialog" class="modal-close-row"><button class="modal-close" aria-label="Close recovery history">×</button></form>
      <p class="section-kicker">YOUR SAFETY NET</p>
      <h2 id="history-title">Recovery history</h2>
      <p class="modal-copy">Versions saved before imports and restores. They stay here until you remove them.</p>
      <div class="history-layout">
        <ul class="history-list" id="history-list"></ul>
        <section class="history-preview" id="history-preview" aria-live="polite">
          <div class="history-preview-empty"><span aria-hidden="true">↺</span><p>Choose a recovery point to see what it contains.</p></div>
        </section>
      </div>
    </dialog>

    <script>
      type TaskState = 'active' | 'completed' | 'trashed';
      type Task = {
        id: string; title: string; notes: string; state: TaskState; created_at: string;
        completed_at: string | null; trashed_at: string | null; active_position: number;
        state_before_trash?: TaskState; etag: string;
      };
      type Counts = { active: number; completed: number; trashed: number };
      type ListResponse = { tasks: Task[]; counts: Counts };
      type ImportPreview = { id: string; current_counts: Counts; incoming_counts: Counts; incoming_tasks: Omit<Task, 'etag'>[]; list_etag: string };
      type RecoveryPoint = { id: string; created_at: string; task_count: number };
      type RecoveryPreview = { recovery_point: RecoveryPoint; counts: Counts; tasks: Omit<Task, 'etag'>[]; list_etag: string };
      type ApiFailureBody = { error?: { code?: string; message?: string }; preview?: ImportPreview & Record<string, unknown> };

      const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector)!;
      const taskList = $('#task-list');
      const emptyState = $('#empty-state');
      const notice = $('#notice');
      const importDialog = $('#import-dialog') as HTMLDialogElement;
      const historyDialog = $('#history-dialog') as HTMLDialogElement;
      let currentView: TaskState = 'active';
      let allTasks: Task[] = [];
      let counts: Counts = { active: 0, completed: 0, trashed: 0 };
      let listEtag = '"list:0"';
      let searchSequence = 0;
      let importPreview: ImportPreview | null = null;
      let recoveryPreview: RecoveryPreview | null = null;
      let importNeedsReconfirm = false;
      let recoveryNeedsReconfirm = false;
      let draggedTaskId: string | null = null;
      let noticeTimer: number | undefined;

      const viewCopy: Record<TaskState, { kicker: string; title: string; subtitle: string; emptyTitle: string; emptyCopy: string }> = {
        active: { kicker: 'A FRESH START', title: 'Your active list', subtitle: 'One thing at a time is plenty.', emptyTitle: 'A little room to begin.', emptyCopy: 'Add a task above and let the day unfold.' },
        completed: { kicker: 'LOOK HOW FAR YOU CAME', title: 'Taken care of', subtitle: 'The things you finished are worth seeing.', emptyTitle: 'Nothing checked off yet.', emptyCopy: 'Finish a task and it will find a home here.' },
        trashed: { kicker: 'ROOM TO LET GO', title: 'In the trash', subtitle: 'Removed tasks stay here until you decide.', emptyTitle: 'Your trash is clear.', emptyCopy: 'Removed tasks will wait here in case you need them.' },
      };

      function showNotice(message: string, kind: 'good' | 'warning' | 'bad' = 'good') {
        window.clearTimeout(noticeTimer);
        notice.textContent = message;
        notice.className = `notice notice-${kind}`;
        notice.hidden = false;
        noticeTimer = window.setTimeout(() => { notice.hidden = true; }, 5200);
      }

      async function request<T>(path: string, init: RequestInit = {}): Promise<{ data: T; response: Response }> {
        const headers = new Headers(init.headers);
        if (init.body && !(init.body instanceof FormData)) headers.set('Content-Type', 'application/json');
        const response = await fetch(`/api${path}`, { ...init, headers });
        if (!response.ok) {
          let body: ApiFailureBody = {};
          try { body = await response.json() as ApiFailureBody; } catch { /* keep the fallback */ }
          const error = new Error(body.error?.message || `Request failed (${response.status}).`) as Error & { status: number; body: ApiFailureBody };
          error.status = response.status;
          error.body = body;
          throw error;
        }
        if (response.status === 204) return { data: undefined as T, response };
        return { data: await response.json() as T, response };
      }

      async function refreshTasks(query = '') {
        const sequence = ++searchSequence;
        const suffix = query ? `?q=${encodeURIComponent(query)}` : '';
        const { data, response } = await request<ListResponse>(`/tasks${suffix}`);
        if (sequence !== searchSequence) return;
        allTasks = data.tasks;
        counts = data.counts;
        listEtag = response.headers.get('ETag') || '"list:0"';
        render();
      }

      function render() {
        $('#active-count').textContent = String(counts.active);
        $('#completed-count').textContent = String(counts.completed);
        $('#nav-active-count').textContent = String(counts.active);
        $('#nav-completed-count').textContent = String(counts.completed);
        $('#nav-trashed-count').textContent = String(counts.trashed);
        const copy = viewCopy[currentView];
        $('#list-kicker').textContent = copy.kicker;
        $('#list-title').textContent = copy.title;
        $('#list-subtitle').textContent = copy.subtitle;
        $('#empty-title').textContent = copy.emptyTitle;
        $('#empty-copy').textContent = copy.emptyCopy;
        const query = ($('#search-input') as HTMLInputElement).value.trim();
        $('#result-label').textContent = query ? `MATCHES FOR “${query.toLocaleUpperCase()}”` : currentView === 'active' ? 'YOUR NEXT STEPS' : currentView === 'completed' ? 'WORTH REMEMBERING' : 'WAITING HERE';
        const isSearch = query.length > 0;
        const visibleTasks = isSearch ? allTasks : allTasks.filter(task => task.state === currentView);
        taskList.replaceChildren(...visibleTasks.map((task, index) => taskCard(task, index, visibleTasks.length, isSearch)));
        emptyState.hidden = visibleTasks.length > 0;
        if (isSearch && visibleTasks.length === 0) {
          $('#empty-title').textContent = 'No matching tasks.';
          $('#empty-copy').textContent = 'Try a different word or phrase.';
        }
        $('#task-form').toggleAttribute('hidden', currentView !== 'active' || isSearch);
        $('#empty-trash-button').toggleAttribute('hidden', currentView !== 'trashed' || counts.trashed === 0 || isSearch);
        document.querySelectorAll<HTMLButtonElement>('.view-button').forEach(button => {
          const selected = button.dataset.view === currentView;
          button.classList.toggle('is-selected', selected);
          if (selected) button.setAttribute('aria-current', 'page'); else button.removeAttribute('aria-current');
        });
        $('.nav-tip').classList.toggle('tip-muted', currentView !== 'active' || isSearch);
      }

      function taskCard(task: Task, index: number, length: number, isSearch: boolean): HTMLLIElement {
        const card = document.createElement('li');
        card.className = `task-card task-${task.state}`;
        card.dataset.id = task.id;
        const active = task.state === 'active';
        card.draggable = active && !isSearch;
        const stateButton = document.createElement('button');
        stateButton.className = `task-check ${task.state === 'completed' ? 'is-checked' : ''}`;
        stateButton.type = 'button';
        stateButton.setAttribute('aria-label', active ? `Mark ${task.title} complete` : `Reopen ${task.title}`);
        stateButton.textContent = task.state === 'completed' ? '✓' : '';
        if (task.state !== 'trashed') stateButton.addEventListener('click', () => changeState(task, active ? 'completed' : 'active'));
        else stateButton.hidden = true;

        const copy = document.createElement('div');
        copy.className = 'task-copy';
        const title = document.createElement('h3');
        title.textContent = task.title;
        copy.append(title);
        if (task.notes) {
          const notes = document.createElement('p');
          notes.className = 'task-notes';
          notes.textContent = task.notes;
          copy.append(notes);
        }
        if (isSearch) {
          const state = document.createElement('span');
          state.className = 'state-pill';
          state.textContent = task.state === 'trashed' ? 'Trash' : task.state === 'completed' ? 'Completed' : 'Active';
          copy.append(state);
        }

        const actions = document.createElement('div');
        actions.className = 'task-actions';
        if (task.state === 'trashed') {
          const restore = actionButton('Restore task', '↶', 'Restore');
          restore.addEventListener('click', () => restoreTask(task));
          actions.append(restore);
        } else {
          if (!isSearch && active) {
            const up = actionButton('Move task up', '↑');
            up.disabled = index === 0;
            up.addEventListener('click', () => moveTask(task.id, -1));
            const down = actionButton('Move task down', '↓');
            down.disabled = index === length - 1;
            down.addEventListener('click', () => moveTask(task.id, 1));
            actions.append(up, down);
          }
          const edit = actionButton(`Edit ${task.title}`, '···', 'Edit');
          edit.addEventListener('click', () => startEditing(card, task));
          actions.append(edit);
          const remove = actionButton(`Move ${task.title} to trash`, '⌑');
          remove.classList.add('remove-action');
          remove.addEventListener('click', () => trashTask(task));
          actions.append(remove);
        }
        card.append(stateButton, copy, actions);
        if (active && !isSearch) {
          card.addEventListener('dragstart', event => {
            draggedTaskId = task.id;
            card.classList.add('is-dragging');
            event.dataTransfer?.setData('text/plain', task.id);
            if (event.dataTransfer) event.dataTransfer.effectAllowed = 'move';
          });
          card.addEventListener('dragend', () => { draggedTaskId = null; card.classList.remove('is-dragging'); });
          card.addEventListener('dragover', event => { event.preventDefault(); card.classList.add('drop-target'); });
          card.addEventListener('dragleave', () => card.classList.remove('drop-target'));
          card.addEventListener('drop', event => {
            event.preventDefault();
            card.classList.remove('drop-target');
            const sourceId = event.dataTransfer?.getData('text/plain') || draggedTaskId;
            if (sourceId && sourceId !== task.id) dropTask(sourceId, task.id);
          });
        }
        return card;
      }

      function actionButton(label: string, icon: string, text?: string): HTMLButtonElement {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'task-action';
        button.setAttribute('aria-label', label);
        if (text) {
          button.textContent = text;
          button.classList.add('action-with-label');
        } else {
          button.textContent = icon;
        }
        return button;
      }

      function validateLength(input: HTMLInputElement | HTMLTextAreaElement, limit: number, label: string, trim = false) {
        const value = trim ? input.value.trim() : input.value;
        const valid = Array.from(value).length <= limit && (!trim || value.length > 0);
        const message = trim && value.length === 0
          ? 'Title must contain non-whitespace text.'
          : `${label} may contain at most ${limit.toLocaleString()} characters.`;
        input.setCustomValidity(valid ? '' : message);
        return valid;
      }

      function startEditing(card: HTMLLIElement, task: Task) {
        card.classList.add('is-editing');
        const titleInput = document.createElement('input');
        titleInput.className = 'edit-title'; titleInput.value = task.title; titleInput.setAttribute('aria-label', 'Task title');
        const notesInput = document.createElement('textarea');
        notesInput.className = 'edit-notes'; notesInput.rows = 2; notesInput.value = task.notes; notesInput.setAttribute('aria-label', 'Task notes');
        titleInput.addEventListener('input', () => validateLength(titleInput, 500, 'Title', true));
        notesInput.addEventListener('input', () => validateLength(notesInput, 20000, 'Notes'));
        const fields = document.createElement('div'); fields.className = 'edit-fields'; fields.append(titleInput, notesInput);
        const actions = document.createElement('div'); actions.className = 'edit-actions';
        const cancel = document.createElement('button'); cancel.className = 'secondary-button compact-button'; cancel.type = 'button'; cancel.textContent = 'Cancel'; cancel.addEventListener('click', render);
        const save = document.createElement('button'); save.className = 'primary-button compact-button'; save.type = 'button'; save.textContent = 'Save';
        save.addEventListener('click', async () => {
          const titleValid = validateLength(titleInput, 500, 'Title', true);
          const notesValid = validateLength(notesInput, 20000, 'Notes');
          if (!titleValid || !notesValid) { titleInput.reportValidity(); notesInput.reportValidity(); return; }
          save.disabled = true;
          try {
            await request(`/tasks/${task.id}`, { method: 'PATCH', headers: { 'If-Match': task.etag }, body: JSON.stringify({ title: titleInput.value, notes: notesInput.value }) });
            showNotice('Your changes are saved.'); await reloadForSearch();
          } catch (error) { showError(error); save.disabled = false; }
        });
        actions.append(cancel, save);
        const main = document.createElement('div'); main.className = 'edit-main'; main.append(fields, actions);
        card.replaceChildren(main);
        titleInput.focus();
      }

      async function reloadForSearch() { await refreshTasks(($('#search-input') as HTMLInputElement).value.trim()); }

      async function changeState(task: Task, state: 'active' | 'completed') {
        try { await request(`/tasks/${task.id}`, { method: 'PATCH', headers: { 'If-Match': task.etag }, body: JSON.stringify({ state }) }); await reloadForSearch(); }
        catch (error) { showError(error); await reloadForSearch(); }
      }

      async function trashTask(task: Task) {
        try { await request(`/tasks/${task.id}`, { method: 'DELETE', headers: { 'If-Match': task.etag } }); showNotice('Moved to Trash. You can restore it any time.'); await reloadForSearch(); }
        catch (error) { showError(error); await reloadForSearch(); }
      }

      async function restoreTask(task: Task) {
        try { await request(`/tasks/${task.id}/restore`, { method: 'POST', headers: { 'If-Match': task.etag } }); showNotice('Task restored to its earlier place.'); await reloadForSearch(); }
        catch (error) { showError(error); await reloadForSearch(); }
      }

      async function reorder(ids: string[]) {
        try {
          const { response } = await request<{ etag: string }>('/tasks/order', { method: 'PUT', headers: { 'If-Match': listEtag }, body: JSON.stringify({ ids }) });
          listEtag = response.headers.get('ETag') || listEtag;
          await refreshTasks();
        } catch (error) { showError(error); await refreshTasks(); }
      }

      function moveTask(id: string, delta: number) {
        const tasks = allTasks.filter(task => task.state === 'active');
        const index = tasks.findIndex(task => task.id === id);
        const target = index + delta;
        if (target < 0 || target >= tasks.length) return;
        [tasks[index], tasks[target]] = [tasks[target], tasks[index]];
        void reorder(tasks.map(task => task.id));
      }

      function dropTask(sourceId: string, targetId: string) {
        const tasks = allTasks.filter(task => task.state === 'active');
        const source = tasks.findIndex(task => task.id === sourceId);
        const target = tasks.findIndex(task => task.id === targetId);
        if (source < 0 || target < 0) return;
        const [moved] = tasks.splice(source, 1);
        tasks.splice(target, 0, moved);
        void reorder(tasks.map(task => task.id));
      }

      async function emptyTrash() {
        if (!window.confirm(`Permanently delete ${counts.trashed} ${counts.trashed === 1 ? 'task' : 'tasks'}? This cannot be undone.`)) return;
        try { await request('/trash', { method: 'DELETE', headers: { 'If-Match': listEtag } }); showNotice('Trash emptied.'); await refreshTasks(); }
        catch (error) { showError(error); await refreshTasks(); }
      }

      async function exportList() {
        try {
          const response = await fetch('/api/export');
          if (!response.ok) throw new Error('Could not export the To Do List.');
          const blob = await response.blob();
          const link = document.createElement('a');
          link.href = URL.createObjectURL(blob); link.download = 'todo-list.json'; link.click();
          URL.revokeObjectURL(link.href);
          showNotice('Your list export is ready.');
        } catch (error) { showError(error); }
      }

      async function stageImport(file: File) {
        try {
          const { data } = await request<ImportPreview>('/import-previews', { method: 'POST', body: file });
          importPreview = data;
          importNeedsReconfirm = false;
          renderImportPreview();
          importDialog.showModal();
        } catch (error) { showError(error); }
      }

      function renderImportPreview() {
        if (!importPreview) return;
        const warning = $('#import-warning');
        warning.hidden = !importNeedsReconfirm;
        warning.textContent = importNeedsReconfirm ? 'The current list changed while this file was open. Review these refreshed counts and tasks, then confirm the replacement again.' : '';
        const { current_counts, incoming_counts, incoming_tasks } = importPreview;
        $('#import-counts').replaceChildren(countBlock('CURRENT LIST', current_counts), countBlock('INCOMING LIST', incoming_counts));
        const list = $('#import-tasks'); list.replaceChildren();
        if (incoming_tasks.length === 0) {
          const empty = document.createElement('li'); empty.className = 'preview-empty'; empty.textContent = 'This export contains no tasks.'; list.append(empty);
        }
        for (const task of incoming_tasks) {
          list.append(previewTaskRow(task));
        }
        $('#apply-import').textContent = importNeedsReconfirm ? 'Confirm replacement ↗' : 'Replace list ↗';
      }

      function countBlock(label: string, values: Counts) {
        const block = document.createElement('div'); block.className = 'count-block';
        const heading = document.createElement('span'); heading.textContent = label;
        const line = document.createElement('p');
        line.textContent = `${values.active} active · ${values.completed} completed · ${values.trashed} in Trash`;
        block.append(heading, line); return block;
      }

      function previewTaskRow(task: Omit<Task, 'etag'>) {
        const row = document.createElement('li');
        row.className = 'preview-task-row';
        const copy = document.createElement('div'); copy.className = 'preview-task-copy';
        const title = document.createElement('strong'); title.textContent = task.title; copy.append(title);
        if (task.notes) { const notes = document.createElement('p'); notes.textContent = task.notes; copy.append(notes); }
        const state = document.createElement('small');
        state.textContent = task.state === 'active'
          ? `Active · position ${task.active_position + 1}`
          : task.state === 'completed'
            ? 'Completed'
            : `Trash · from ${task.state_before_trash === 'completed' ? 'Completed' : 'Active'}`;
        row.append(copy, state);
        return row;
      }

      async function applyImport() {
        if (!importPreview) return;
        const button = $('#apply-import') as HTMLButtonElement; button.disabled = true;
        ($('#cancel-import') as HTMLButtonElement).disabled = true;
        importDialog.querySelector<HTMLButtonElement>('.modal-close')!.disabled = true;
        try {
          const { data } = await request<{ applied: boolean; recovery_point_id: string; list_etag: string }>(`/import-previews/${importPreview.id}/apply`, { method: 'POST', headers: { 'If-Match': importPreview.list_etag } });
          importDialog.close(); importPreview = null;
          importNeedsReconfirm = false;
          currentView = 'active'; ($('#search-input') as HTMLInputElement).value = '';
          showNotice(`List replaced. A recovery point is available in Recovery History (${data.recovery_point_id.slice(0, 8)}).`);
          await refreshTasks();
        } catch (error) {
          const failure = error as Error & { status?: number; body?: ApiFailureBody };
          if (failure.status === 412 && failure.body?.preview) {
            importPreview = failure.body.preview as ImportPreview;
            importNeedsReconfirm = true;
            renderImportPreview();
          } else showError(error);
        } finally {
          button.disabled = false;
          ($('#cancel-import') as HTMLButtonElement).disabled = false;
          importDialog.querySelector<HTMLButtonElement>('.modal-close')!.disabled = false;
        }
      }

      async function cancelImport() {
        if (importPreview) void request(`/import-previews/${importPreview.id}`, { method: 'DELETE' }).catch(() => {});
        importPreview = null; importNeedsReconfirm = false; importDialog.close();
      }

      async function openHistory() {
        if (!historyDialog.open) historyDialog.showModal();
        $('#history-list').replaceChildren();
        $('#history-preview').replaceChildren();
        const loading = document.createElement('p'); loading.className = 'history-loading'; loading.textContent = 'Loading recovery points…'; $('#history-list').append(loading);
        try {
          const { data } = await request<RecoveryPoint[]>('/recovery-points');
          const list = $('#history-list'); list.replaceChildren();
          if (data.length === 0) {
            const empty = document.createElement('li'); empty.className = 'history-empty'; empty.textContent = 'No recovery points yet. They are created before an import or restore.'; list.append(empty);
            showHistoryEmpty(); return;
          }
          for (const point of data) {
            const item = document.createElement('li'); item.className = 'history-item';
            const select = document.createElement('button'); select.className = 'history-select'; select.type = 'button';
            const date = document.createElement('strong'); date.textContent = formatDate(point.created_at);
            const detail = document.createElement('span'); detail.textContent = `${point.task_count} ${point.task_count === 1 ? 'task' : 'tasks'}`;
            select.append(date, detail); select.addEventListener('click', () => previewRecovery(point));
            const remove = document.createElement('button'); remove.className = 'history-delete'; remove.type = 'button'; remove.setAttribute('aria-label', `Delete recovery point from ${formatDate(point.created_at)}`); remove.textContent = '×';
            remove.addEventListener('click', async () => {
              if (!window.confirm(`Delete the recovery point from ${formatDate(point.created_at)}?`)) return;
              try { await request(`/recovery-points/${point.id}`, { method: 'DELETE' }); showNotice('Recovery point deleted.'); await openHistory(); }
              catch (error) { showError(error); }
            });
            item.append(select, remove); list.append(item);
          }
          await previewRecovery(data[0]);
        } catch (error) { showError(error); }
      }

      function showHistoryEmpty() {
        const section = $('#history-preview');
        const content = document.createElement('div'); content.className = 'history-preview-empty';
        const icon = document.createElement('span'); icon.textContent = '↺';
        const text = document.createElement('p'); text.textContent = 'Choose a recovery point to see what it contains.';
        content.append(icon, text); section.replaceChildren(content);
      }

      async function previewRecovery(point: RecoveryPoint) {
        try {
        const { data } = await request<RecoveryPreview>(`/recovery-points/${point.id}`);
        recoveryPreview = data;
          recoveryNeedsReconfirm = false;
          renderRecoveryPreview();
        } catch (error) { showError(error); }
      }

      function renderRecoveryPreview() {
        if (!recoveryPreview) return;
        const preview = $('#history-preview'); preview.replaceChildren();
        if (recoveryNeedsReconfirm) {
          const warning = document.createElement('p'); warning.className = 'modal-warning'; warning.setAttribute('role', 'status');
          warning.textContent = 'The current list changed after you opened this point. Review the snapshot below, then confirm the restore again.';
          preview.append(warning);
        }
        const heading = document.createElement('p'); heading.className = 'preview-label'; heading.textContent = 'RECOVERY POINT';
        const title = document.createElement('h3'); title.textContent = formatDate(recoveryPreview.recovery_point.created_at);
        const countsLine = document.createElement('p'); countsLine.className = 'recovery-counts'; countsLine.textContent = `${recoveryPreview.counts.active} active · ${recoveryPreview.counts.completed} completed · ${recoveryPreview.counts.trashed} in Trash`;
        const list = document.createElement('ul'); list.className = 'recovery-task-list';
        for (const task of recoveryPreview.tasks) { list.append(previewTaskRow(task)); }
        if (recoveryPreview.tasks.length === 0) { const row = document.createElement('li'); row.className = 'muted-item'; row.textContent = 'No tasks in this version.'; list.append(row); }
        const restore = document.createElement('button'); restore.type = 'button'; restore.className = 'primary-button restore-version'; restore.textContent = 'Restore this version ↗';
        restore.addEventListener('click', () => void restoreRecovery());
        preview.append(heading, title, countsLine, list, restore);
      }

      async function restoreRecovery() {
        if (!recoveryPreview) return;
        if (!window.confirm(`Restore the list from ${formatDate(recoveryPreview.recovery_point.created_at)}? The current list will be saved as a new recovery point.`)) return;
        try {
          const { data } = await request<{ restored: boolean; list_etag: string }>(`/recovery-points/${recoveryPreview.recovery_point.id}/restore`, { method: 'POST', headers: { 'If-Match': recoveryPreview.list_etag } });
          historyDialog.close(); currentView = 'active'; ($('#search-input') as HTMLInputElement).value = '';
          showNotice('That version is restored. The replaced list is now in Recovery History.'); await refreshTasks();
        } catch (error) {
          const failure = error as Error & { status?: number; body?: ApiFailureBody };
          if (failure.status === 412 && failure.body?.preview) {
            const fresh = failure.body.preview as RecoveryPreview & { incoming_tasks: RecoveryPreview['tasks']; incoming_counts: Counts; recovery_point: RecoveryPoint };
            recoveryPreview.list_etag = fresh.list_etag;
            recoveryPreview.tasks = fresh.incoming_tasks;
            recoveryPreview.counts = fresh.incoming_counts;
            recoveryNeedsReconfirm = true;
            renderRecoveryPreview();
          } else showError(error);
        }
      }

      function formatDate(value: string) {
        return new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value));
      }

      function showError(error: unknown) {
        console.error(error);
        showNotice(error instanceof Error ? error.message : 'Something went wrong. Please try again.', 'bad');
      }

      document.querySelectorAll<HTMLButtonElement>('.view-button').forEach(button => button.addEventListener('click', () => {
        currentView = button.dataset.view as TaskState;
        ($('#search-input') as HTMLInputElement).value = '';
        void refreshTasks();
      }));
      $('#task-form').addEventListener('submit', async event => {
        event.preventDefault();
        const title = $('#new-title') as HTMLInputElement;
        const notes = $('#new-notes') as HTMLTextAreaElement;
        const titleValid = validateLength(title, 500, 'Title', true);
        const notesValid = validateLength(notes, 20000, 'Notes');
        if (!titleValid || !notesValid) { title.reportValidity(); notes.reportValidity(); return; }
        const button = $('#task-form button[type="submit"]') as HTMLButtonElement; button.disabled = true;
        try {
          await request<Task>('/tasks', { method: 'POST', body: JSON.stringify({ title: title.value, notes: notes.value }) });
          title.value = ''; notes.value = ''; title.focus();
          showNotice('Added to the top of your list.'); await refreshTasks();
        } catch (error) { showError(error); }
        finally { button.disabled = false; }
      });
      $('#new-title').addEventListener('input', event => validateLength(event.currentTarget as HTMLInputElement, 500, 'Title', true));
      $('#new-notes').addEventListener('input', event => validateLength(event.currentTarget as HTMLTextAreaElement, 20000, 'Notes'));
      $('#search-input').addEventListener('input', () => {
        const value = ($('#search-input') as HTMLInputElement).value.trim();
        window.clearTimeout((window as Window & { searchTimer?: number }).searchTimer);
        (window as Window & { searchTimer?: number }).searchTimer = window.setTimeout(() => void refreshTasks(value), 180);
      });
      $('#search-input').addEventListener('keydown', event => { if ((event as KeyboardEvent).key === 'Escape') { ($('#search-input') as HTMLInputElement).value = ''; void refreshTasks(); } });
      document.addEventListener('keydown', event => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); $('#search-input').focus(); }
      });
      $('#empty-trash-button').addEventListener('click', emptyTrash);
      $('#export-button').addEventListener('click', exportList);
      $('#import-button').addEventListener('click', () => ($('#import-file') as HTMLInputElement).click());
      $('#import-file').addEventListener('change', event => {
        const input = event.currentTarget as HTMLInputElement;
        const file = input.files?.[0]; if (file) void stageImport(file); input.value = '';
      });
      $('#apply-import').addEventListener('click', applyImport);
      $('#cancel-import').addEventListener('click', cancelImport);
      importDialog.addEventListener('close', () => {
        if (importPreview) void request(`/import-previews/${importPreview.id}`, { method: 'DELETE' }).catch(() => {});
        importPreview = null; importNeedsReconfirm = false;
      });
      $('#history-button').addEventListener('click', openHistory);
      historyDialog.addEventListener('close', () => { recoveryPreview = null; recoveryNeedsReconfirm = false; });

      const today = new Intl.DateTimeFormat(undefined, { weekday: 'long', month: 'long', day: 'numeric' });
      $('#today-label').textContent = today.format(new Date());
      void refreshTasks().catch(showError);
    </script>
  </body>
</html>

